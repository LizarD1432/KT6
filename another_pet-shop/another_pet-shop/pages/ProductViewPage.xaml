<Page x:Class="another_pet_shop.pages.ProductViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:another_pet_shop.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Просмотр товаров" Background="White">

    <Grid>
        <Button x:Name="ExitButton" Width="170" Height="30" VerticalAlignment="Bottom" Margin="0, 0, 0, 20" FontFamily="Comic Sans MS" Content="На страницу авторизации" Background="#FF76E383" Click="ExitButton_Click"></Button>
        <Button x:Name="AddNewProductButton" Width="150" Height="30" VerticalAlignment="Bottom" Margin="0, 0, 0, 70" FontFamily="Comic Sans MS" Content="Загрузить новый товар" Background="#FF76E383" Click="AddNewProductButton_Click"></Button>
    </Grid>
</Page>
