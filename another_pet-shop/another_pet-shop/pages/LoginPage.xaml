<Page x:Class="another_pet_shop.pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:another_pet_shop.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация" Background="White">

    <Grid>
        <StackPanel Width="400" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Введите логин" FontFamily="Comic Sans MS" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
            <TextBox Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="LoginTextBox" Margin="0, 0, 0, 15"></TextBox>

            <Label Content="Введите пароль" FontFamily="Comic Sans MS" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
            <PasswordBox Width="200" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="PasswordTextBox" Margin="0, 0, 0, 30"></PasswordBox>

            <Button x:Name="LoginButton" Click="LoginButton_Click" Width="130" Height="30" FontFamily="Comic Sans MS" Content="Войти" Margin="0, 0, 0, 20" Background="#FF76E383"></Button>
            <Button x:Name="GuestEnterButton" Click="GuestEnter_Click" Width="130" Height="30" FontFamily="Comic Sans MS" Content="Гостевой вход" Background="#FF76E383"></Button>

            <Label Width="300" Height="35" FontFamily="Comic Sans MS" FontSize="16" Margin="0, 30, 0, 0" Foreground="Red" x:Name="ErrorNotificator"></Label>
        </StackPanel>
    </Grid>
</Page>
